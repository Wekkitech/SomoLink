{
  "name": "somolink-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SomoLink - AI-Powered Solar-Driven Digital Learning Infrastructure",
  "author": "Wekkitech Limited <dev@wekkitech.co.ke>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wekkitech/somolink.git"
  },
  "workspaces": [
    "apps/*",
    "services/api-gateway",
    "libs/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm:dev:*\"",
    "dev:gateway": "pnpm --filter @somolink/api-gateway dev",
    "dev:school-dashboard": "pnpm --filter @somolink/school-dashboard dev",
    "dev:admin-dashboard": "pnpm --filter @somolink/admin-dashboard dev",
    "build": "turbo run build",
    "build:gateway": "pnpm --filter @somolink/api-gateway build",
    "build:dashboards": "pnpm --filter \"@somolink/*dashboard\" build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:build": "./scripts/docker/build-all.sh",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "db:migrate": "pnpm --filter @somolink/api-gateway db:migrate",
    "db:seed": "pnpm --filter @somolink/api-gateway db:seed",
    "prepare": "husky install",
    "precommit": "lint-staged",
    "version:bump": "changeset version",
    "version:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.9",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.go": [
      "gofmt -w",
      "go vet"
    ],
    "*.py": [
      "black",
      "isort"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "perf",
          "test",
          "build",
          "ci",
          "chore",
          "revert"
        ]
      ],
      "scope-enum": [
        2,
        "always",
        [
          "edge-agent",
          "ai-platform",
          "api-gateway",
          "school-dashboard",
          "admin-dashboard",
          "billing",
          "data-ingestion",
          "infra",
          "docs"
        ]
      ]
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "arrowParens": "always"
  }
}
