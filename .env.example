# SomoLink Environment Configuration Template
# Copy this file to .env and fill in actual values
# NEVER commit .env file to version control

###############################
# GENERAL SETTINGS
###############################
NODE_ENV=development
LOG_LEVEL=info
TZ=Africa/Nairobi

###############################
# DATABASE CONFIGURATION
###############################
# PostgreSQL (Main Database)
DATABASE_URL=postgresql://somolink:your_password@localhost:5432/somolink
POSTGRES_USER=somolink
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=somolink

# TimescaleDB (Telemetry)
TIMESCALEDB_URL=postgresql://somolink:your_password@localhost:5433/telemetry

###############################
# CACHE & MESSAGE QUEUE
###############################
# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=somolink-api
KAFKA_GROUP_ID=somolink-consumer-group

###############################
# AUTHENTICATION & SECURITY
###############################
# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# OAuth2 (if using external providers)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# API Keys
API_KEY_MASTER=your_master_api_key_for_internal_services

###############################
# AI PLATFORM CONFIGURATION
###############################
# Model Paths
SOLAR_MODEL_PATH=/models/solar
QOS_MODEL_PATH=/models/qos
ANOMALY_MODEL_PATH=/models/anomaly

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_EXPERIMENT_NAME=somolink-models

# External APIs
OPENWEATHER_API_KEY=your_openweather_api_key
WEATHER_API_ENDPOINT=https://api.openweathermap.org/data/2.5

###############################
# OBJECT STORAGE (MinIO/S3)
###############################
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=somolink-data
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

###############################
# MONITORING & OBSERVABILITY
###############################
# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000

# Jaeger (Tracing)
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1

# OpenTelemetry
OTEL_SERVICE_NAME=somolink
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

###############################
# EDGE DEVICE CONFIGURATION
###############################
# Edge Agent
DEVICE_ID=SLNK-001-KE
DEVICE_LOCATION_LAT=-1.286389
DEVICE_LOCATION_LON=36.817223
TELEMETRY_INTERVAL_SECONDS=60
SYNC_INTERVAL_SECONDS=300

# MPPT Controller
MPPT_SERIAL_PORT=/dev/ttyUSB0
MPPT_BAUD_RATE=19200

# Modem Configuration
MODEM_APN=safaricom
MODEM_DEVICE=/dev/ttyUSB1

###############################
# BILLING & PAYMENTS
###############################
# M-Pesa (Kenya Mobile Money)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=https://api.somolink.co.ke/webhook/mpesa

# Stripe (Alternative)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

###############################
# FRONTEND APPLICATIONS
###############################
# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token
NEXT_PUBLIC_SENTRY_DSN=

###############################
# NOTIFICATIONS
###############################
# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@somolink.co.ke
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_NAME=SomoLink

# SMS (Africa's Talking)
AFRICAS_TALKING_API_KEY=your_api_key
AFRICAS_TALKING_USERNAME=sandbox

# Slack (Alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

###############################
# DEVELOPMENT TOOLS
###############################
# Debug
DEBUG=somolink:*
VERBOSE_LOGGING=false

# Testing
TEST_DATABASE_URL=postgresql://somolink:test@localhost:5432/somolink_test

###############################
# PRODUCTION SETTINGS
###############################
# Domain & SSL
DOMAIN=somolink.wekkitech.co.ke
SSL_CERT_PATH=/etc/letsencrypt/live/somolink.wekkitech.co.ke/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/somolink.wekkitech.co.ke/privkey.pem

# CORS
CORS_ORIGINS=https://somolink.wekkitech.co.ke,https://admin.somolink.wekkitech.co.ke

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

###############################
# FEATURE FLAGS
###############################
ENABLE_FEDERATED_LEARNING=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_SAFE_BROWSING=true
ENABLE_CONTENT_FILTERING=true

###############################
# KUBERNETES SECRETS
# (Only for K8s deployments, not used in .env)
###############################
# These are managed through kubectl create secret
# Listed here for reference only
# - database-credentials
# - redis-credentials
# - jwt-secret
# - mpesa-credentials
# - aws-credentials
